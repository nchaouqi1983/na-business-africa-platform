// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]

  createdProperties  Property[]         @relation("PropertyCreatedBy")
  assignedProperties Property[]         @relation("PropertyAssignedTo")
  updatedProperties  Property[]         @relation("PropertyUpdatedBy")
  uploadedMedia      PropertyMedia[]    @relation("PropertyMediaUploadedBy")
  uploadedDocuments  PropertyDocument[] @relation("PropertyDocumentUploadedBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Property registry (phase 6B1)
//
// Enum values are mapped (`@map`) to the exact slugs already used by the
// public-facing catalogue contract in lib/property-schema.ts, so the two
// vocabularies never drift apart even though Prisma enum identifiers must be
// SCREAMING_SNAKE_CASE. See lib/admin/property-enum-maps.ts for the
// runtime conversion helpers. PublicationStatus and Visibility are new
// back-office concepts with no public-schema equivalent yet, so they use
// plain identifiers.
// ---------------------------------------------------------------------------

enum PropertyTransaction {
  VENTE
  LOCATION
  LOCATION_SAISONNIERE @map("location-saisonniere")
  PROGRAMME_NEUF       @map("programme-neuf")
}

enum PropertyType {
  VILLA
  MAISON
  RIAD
  APPARTEMENT
  DUPLEX
  PENTHOUSE
  TERRAIN
  HOTEL
  MAISON_HOTES      @map("maison-hotes")
  RESTAURANT
  COMMERCE
  BUREAU
  DEPOT
  FONDS_DE_COMMERCE @map("fonds-de-commerce")
  PROGRAMME_NEUF    @map("programme-neuf")
}

/**
 * Statut métier du bien. Sous-ensemble volontaire de commercialStatusValues :
 * "sous-compromis" et "off-market" ne sont pas repris ici (off-market est
 * couvert par Visibility.OFF_MARKET).
 */
enum PropertyStatus {
  DISPONIBLE
  RESERVE    @map("reserve")
  VENDU
  LOUE       @map("loue")
  RETIRE     @map("retire")
}

enum PublicationStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}

enum Visibility {
  PUBLIC
  OFF_MARKET
  PRIVE
}

enum FurnishedState {
  MEUBLE
  SEMI_MEUBLE @map("semi-meuble")
  NON_MEUBLE  @map("non-meuble")
}

enum PropertyCondition {
  NEUF
  EXCELLENT
  BON_ETAT     @map("bon-etat")
  A_RAFRAICHIR @map("a-rafraichir")
  A_RENOVER    @map("a-renover")
  A_DEMOLIR    @map("a-demolir")
}

enum Orientation {
  NORD
  SUD
  EST
  OUEST
  NORD_EST   @map("nord-est")
  NORD_OUEST @map("nord-ouest")
  SUD_EST    @map("sud-est")
  SUD_OUEST  @map("sud-ouest")
}

enum TagCategory {
  EXTERIEUR     @map("exterieur")
  CONFORT       @map("confort")
  SECURITE      @map("securite")
  LOISIRS       @map("loisirs")
  TECHNIQUE     @map("technique")
  JURIDIQUE     @map("juridique")
  MARKETING
  VUE           @map("vue")
  ENVIRONNEMENT @map("environnement")
  PROXIMITE     @map("proximite")
}

model Property {
  id        String @id @default(cuid())
  reference String @unique
  slug      String @unique

  titleFr          String
  shortDescription String?
  descriptionFr    String?

  transaction     PropertyTransaction
  propertyType    PropertyType
  propertySubtype String?

  status            PropertyStatus    @default(DISPONIBLE)
  publicationStatus PublicationStatus @default(BROUILLON)
  visibility        Visibility        @default(PUBLIC)

  city           String
  district       String?
  addressPublic  String?
  latitude       Float?
  longitude      Float?
  proximityNotes String?

  currency              String   @default("MAD")
  price                 Decimal? @db.Decimal(14, 2)
  priceOnRequest        Boolean  @default(false)
  pricePerSqm           Decimal? @db.Decimal(14, 2)
  negotiable            Boolean  @default(false)
  agencyFeePercent      Decimal? @db.Decimal(5, 2)
  monthlyCharges        Decimal? @db.Decimal(14, 2)
  securityDeposit       Decimal? @db.Decimal(14, 2)
  estimatedYieldPercent Decimal? @db.Decimal(5, 2)

  livingArea   Float?
  builtArea    Float?
  landArea     Float?
  terraceArea  Float?
  balconyArea  Float?
  basementArea Float?

  bedrooms      Int?
  suites        Int?
  bathrooms     Int?
  salons        Int?
  kitchens      Int?
  parkingSpaces Int?
  floor         Int?
  totalFloors   Int?

  yearBuilt   Int?
  furnished   FurnishedState?
  condition   PropertyCondition?
  orientation Orientation?

  isFeatured          Boolean @default(false)
  isGoodDeal          Boolean @default(false)
  isCoupDeCoeur       Boolean @default(false)
  isCreditEligible    Boolean @default(false)
  isMourabahaEligible Boolean @default(false)

  /**
   * Champs conditionnels très spécifiques par type (villa, riad, terrain,
   * hôtel, commerce, bureau, dépôt, programme neuf). Ne doit jamais contenir
   * les champs publics essentiels déjà modélisés ci-dessus. Validé par
   * lib/admin/property-details-schema.ts (union discriminée par `kind`,
   * calquée sur PropertyTypeGroup de lib/property-schema.ts).
   */
  details Json?

  publishedAt DateTime?
  archivedAt  DateTime?

  createdById String
  createdBy   User   @relation("PropertyCreatedBy", fields: [createdById], references: [id])

  /**
   * Dernier utilisateur ayant enregistré une modification (dossier, tags ou
   * données privées) — affiché dans l'écran d'édition à côté de updatedAt.
   */
  updatedById String?
  updatedBy   User?   @relation("PropertyUpdatedBy", fields: [updatedById], references: [id])

  /**
   * Bien attribué à un EDITOR (ou, depuis la 6B2, un AGENT) — seul champ qui
   * lui donne le droit de le modifier en dehors de ce qu'il a lui-même créé
   * (aucun accès aux données privées ni à la publication).
   */
  assignedToId String?
  assignedTo   User?   @relation("PropertyAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags          PropertyTag[]
  private       PropertyPrivate?
  media         PropertyMedia[]
  documents     PropertyDocument[]
  externalLinks PropertyExternalLink[]

  /**
   * Optional rattachement à un programme neuf / lot (phase 6E) — jamais
   * requis, jamais lu par le site public. Un lot peut en principe être
   * rattaché à un seul bien à la fois mais ce n'est pas imposé au niveau
   * schéma (voir lib/real-estate-network/property-links-actions.ts).
   */
  developmentProgramId String?
  developmentProgram   DevelopmentProgram? @relation(fields: [developmentProgramId], references: [id])
  developmentLotId     String?
  developmentLot       DevelopmentLot?     @relation(fields: [developmentLotId], references: [id])

  owners         PropertyOwner[]
  intermediaries PropertyIntermediary[]

  @@index([city])
  @@index([transaction])
  @@index([propertyType])
  @@index([publicationStatus])
  @@index([visibility])
  @@index([status])
  @@index([developmentProgramId])
  @@index([developmentLotId])
}

/**
 * Compteur atomique pour la référence NHA-YYYY-000001. Une ligne par année ;
 * l'incrément se fait par un seul UPSERT SQL (voir lib/admin/reference.ts),
 * jamais par un `count()` des biens existants (non sûr en concurrence).
 */
model PropertyReferenceCounter {
  year Int @id
  seq  Int @default(0)
}

model PropertyTag {
  id       String      @id @default(cuid())
  slug     String      @unique
  labelFr  String
  category TagCategory
  isActive Boolean     @default(true)

  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Physiquement séparée de Property : jamais lue par le site public, jamais
 * incluse dans une réponse envoyée à un rôle autre que SUPER_ADMIN/ADMIN
 * (voir lib/property-permissions.ts, canViewPrivateData).
 */
model PropertyPrivate {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  privateAddress String?
  ownerName      String?
  ownerPhone     String?
  ownerEmail     String?

  mandateReference String?
  mandateStartDate DateTime?
  mandateEndDate   DateTime?

  minimumNetPrice Decimal? @db.Decimal(14, 2)
  internalNotes   String?
  source          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Property media (phase 6C)
//
// Local-disk storage only for now: masters and generated variants live under
// storage/properties/{propertyId}/{mediaId}/ (outside public/, git-ignored),
// never served directly — see lib/media/storage.ts and the admin-only
// streaming route at app/api/admin/media/[mediaId]/[variant]/route.ts.
// `storageKey` is the propertyId/mediaId folder key, kept distinct from the
// filesystem path helper so a future move to Cloudflare R2/Images only has
// to change lib/media/storage.ts, not this schema or any caller.
// ---------------------------------------------------------------------------

enum MediaType {
  IMAGE
}

model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       MediaType @default(IMAGE)

  originalFilename String
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?

  /**
   * sha256 of the original file — used to reject obvious duplicates per bien.
   */
  checksum String

  storageKey String

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)
  altText   String?

  uploadedById String
  uploadedBy   User   @relation("PropertyMediaUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, checksum])
  @@index([propertyId, sortOrder])
}

// ---------------------------------------------------------------------------
// Property documents & external links (phase 6D)
//
// Documents: PDF-only master files, local disk, same layout philosophy as
// PropertyMedia — never under public/, never served except through the
// authenticated streaming route at app/api/admin/documents/[documentId]/route.ts.
// Kept in their own storage/properties/{propertyId}/documents/{documentId}/
// subtree so a documentId can never collide with a mediaId's folder.
// DOCUMENT_JURIDIQUE and MANDAT are restricted to ADMIN/SUPER_ADMIN at the
// query/action layer (see canViewPrivateData in lib/property-permissions.ts) —
// there is no schema-level enforcement of that, it must be re-checked by
// every caller.
//
// External links: URL-only rows, domain-allowlisted per type at the action
// layer (lib/admin/property-external-link-schema.ts) — nothing is ever
// fetched from YouTube/Vimeo/Instagram/TikTok, the row just stores the URL.
//
// `visibility` on both models is a future "publish to the public site" flag
// with no public-site wiring yet — every write defaults it to INTERNE, and
// the action layer refuses PUBLIABLE outright while the bien's own
// visibility is OFF_MARKET or PRIVE.
// ---------------------------------------------------------------------------

enum DocumentType {
  BROCHURE
  PLAN
  DOCUMENT_JURIDIQUE
  MANDAT
  AUTRE
}

enum AssetVisibility {
  INTERNE
  PUBLIABLE
}

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type  DocumentType
  title String

  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String

  visibility AssetVisibility @default(INTERNE)
  sortOrder  Int             @default(0)

  uploadedById String
  uploadedBy   User   @relation("PropertyDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, sortOrder])
}

enum ExternalLinkType {
  VIDEO_YOUTUBE
  VIDEO_VIMEO
  VISITE_VIRTUELLE
  INSTAGRAM
  TIKTOK
  AUTRE
}

model PropertyExternalLink {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type  ExternalLinkType
  url   String
  title String?

  visibility AssetVisibility @default(INTERNE)
  sortOrder  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, sortOrder])
}

// ---------------------------------------------------------------------------
// Real-estate network (phase 6E)
//
// Owners, promoters/programs/lots and intermediaries are strictly internal —
// never read by the public site, never exposed to AGENT/EDITOR/VIEWER (see
// lib/real-estate-network/permissions.ts, canManageRealEstateNetwork). Every
// query/action layer must re-check that helper itself; there is no
// schema-level enforcement.
//
// PropertyPrivate.ownerName/ownerPhone/ownerEmail (phase 6B2) are untouched —
// they keep surfacing as unstructured historical data until a real Owner is
// linked through PropertyOwner. No automatic migration between the two.
// ---------------------------------------------------------------------------

enum PartyKind {
  PHYSIQUE
  SOCIETE
}

enum ContactPreference {
  TELEPHONE
  EMAIL
  WHATSAPP
  COURRIER
}

enum ProgramStatus {
  ETUDE
  COMMERCIALISATION
  LIVRE
  SUSPENDU
}

enum LotStatus {
  DISPONIBLE
  OPTIONNE
  RESERVE
  VENDU
}

enum IntermediaryType {
  APPORTEUR
  AGENCE_PARTENAIRE
  COURTIER
  NOTAIRE
  AUTRE
}

enum PropertyOwnerRole {
  PROPRIETAIRE
  INDIVISAIRE
  USUFRUITIER
  MANDATAIRE
  AUTRE
}

enum CommissionType {
  POURCENTAGE
  FORFAIT
}

model Owner {
  id                String             @id @default(cuid())
  kind              PartyKind          @default(PHYSIQUE)
  fullNameOrCompany String
  cinOrIce          String?
  phone             String?
  email             String?
  address           String?
  city              String?
  contactPreference ContactPreference?
  internalNotes     String?
  isActive          Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyLinks PropertyOwner[]

  @@index([isActive])
  @@index([city])
}

model Promoter {
  id              String  @id @default(cuid())
  companyName     String
  mainContactName String?
  phone           String?
  email           String?
  website         String?
  ice             String?
  address         String?
  city            String?
  internalNotes   String?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs DevelopmentProgram[]

  @@index([isActive])
  @@index([city])
}

model DevelopmentProgram {
  id         String   @id @default(cuid())
  promoterId String
  promoter   Promoter @relation(fields: [promoterId], references: [id])

  name                 String
  city                 String
  district             String?
  address              String?
  latitude             Float?
  longitude            Float?
  internalDescription  String?
  status               ProgramStatus @default(ETUDE)
  expectedDeliveryDate DateTime?
  indicativeLotCount   Int?
  isActive             Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots       DevelopmentLot[]
  properties Property[]

  @@index([promoterId])
  @@index([isActive])
  @@index([status])
}

model DevelopmentLot {
  id        String             @id @default(cuid())
  programId String
  program   DevelopmentProgram @relation(fields: [programId], references: [id])

  reference String
  lotType   String?
  typology  String?
  surface   Float?
  price     Decimal?  @db.Decimal(14, 2)
  status    LotStatus @default(DISPONIBLE)
  floor     String?
  block     String?
  extraInfo Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@unique([programId, reference])
  @@index([status])
}

model Intermediary {
  id            String           @id @default(cuid())
  kind          PartyKind        @default(PHYSIQUE)
  nameOrCompany String
  phone         String?
  email         String?
  type          IntermediaryType @default(AUTRE)
  city          String?
  internalNotes String?
  isActive      Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyLinks PropertyIntermediary[]

  @@index([isActive])
  @@index([type])
}

/**
 * Many-to-many Property <-> Owner, with per-link ownership metadata.
 */
model PropertyOwner {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      Owner    @relation(fields: [ownerId], references: [id])

  role          PropertyOwnerRole @default(PROPRIETAIRE)
  quoteShare    Decimal?          @db.Decimal(5, 2)
  isMainContact Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, ownerId])
  @@index([ownerId])
}

/**
 * Many-to-many Property <-> Intermediary. Commission fields are placeholders
 * for the future financial module (kept optional, never computed here).
 */
model PropertyIntermediary {
  id             String       @id @default(cuid())
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  intermediaryId String
  intermediary   Intermediary @relation(fields: [intermediaryId], references: [id])

  role IntermediaryType?
  note String?

  commissionType   CommissionType?
  commissionRate   Decimal?        @db.Decimal(5, 2)
  commissionAmount Decimal?        @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, intermediaryId])
  @@index([intermediaryId])
}
