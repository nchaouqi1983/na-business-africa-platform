// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  EDITOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(VIEWER)
  /// Soft deactivation only — users are never physically deleted. An
  /// inactive account can't sign in and its sessions are revoked.
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]

  createdProperties  Property[]         @relation("PropertyCreatedBy")
  assignedProperties Property[]         @relation("PropertyAssignedTo")
  updatedProperties  Property[]         @relation("PropertyUpdatedBy")
  uploadedMedia      PropertyMedia[]    @relation("PropertyMediaUploadedBy")
  uploadedDocuments  PropertyDocument[] @relation("PropertyDocumentUploadedBy")

  createdMandates        Mandate[]         @relation("MandateCreatedBy")
  createdCommissionCases CommissionCase[]  @relation("CommissionCaseCreatedBy")
  commissionShareAsAgent CommissionShare[] @relation("CommissionShareAgent")

  createdProspects   Prospect[] @relation("ProspectCreatedBy")
  assignedProspects  Prospect[] @relation("ProspectAssignedTo")
  createdVisits      Visit[]    @relation("VisitCreatedBy")
  assignedVisits     Visit[]    @relation("VisitAssignedTo")
  createdActivities  Activity[] @relation("ActivityCreatedBy")
  assignedActivities Activity[] @relation("ActivityAssignedTo")

  notifications Notification[]

  createdOpportunities    Opportunity[]             @relation("OpportunityCreatedBy")
  assignedOpportunities   Opportunity[]             @relation("OpportunityAssignedTo")
  opportunityStageChanges OpportunityStageHistory[] @relation("OpportunityStageChangedBy")

  createdImportBatches PropertyImportBatch[] @relation("PropertyImportBatchCreatedBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

/// Singleton (id is always "default") holding the agency's own identity and
/// defaults, edited from /admin/parametres by SUPER_ADMIN/ADMIN only.
model OrganizationSettings {
  id              String   @id @default("default")
  agencyName      String   @default("NA Business Africa")
  tagline         String?
  email           String?
  phone           String?
  whatsapp        String?
  address         String?
  city            String?
  website         String?
  instagramUrl    String?
  facebookUrl     String?
  linkedinUrl     String?
  defaultLanguage String   @default("fr")
  timezone        String   @default("Africa/Casablanca")
  defaultCurrency String   @default("MAD")
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Property registry (phase 6B1)
//
// Enum values are mapped (`@map`) to the exact slugs already used by the
// public-facing catalogue contract in lib/property-schema.ts, so the two
// vocabularies never drift apart even though Prisma enum identifiers must be
// SCREAMING_SNAKE_CASE. See lib/admin/property-enum-maps.ts for the
// runtime conversion helpers. PublicationStatus and Visibility are new
// back-office concepts with no public-schema equivalent yet, so they use
// plain identifiers.
// ---------------------------------------------------------------------------

enum PropertyTransaction {
  VENTE
  LOCATION
  LOCATION_SAISONNIERE @map("location-saisonniere")
  PROGRAMME_NEUF       @map("programme-neuf")
}

enum PropertyType {
  VILLA
  MAISON
  RIAD
  APPARTEMENT
  DUPLEX
  PENTHOUSE
  TERRAIN
  HOTEL
  MAISON_HOTES      @map("maison-hotes")
  RESTAURANT
  COMMERCE
  BUREAU
  DEPOT
  FONDS_DE_COMMERCE @map("fonds-de-commerce")
  PROGRAMME_NEUF    @map("programme-neuf")
}

/**
 * Statut métier du bien. Sous-ensemble volontaire de commercialStatusValues :
 * "sous-compromis" et "off-market" ne sont pas repris ici (off-market est
 * couvert par Visibility.OFF_MARKET).
 */
enum PropertyStatus {
  DISPONIBLE
  RESERVE    @map("reserve")
  VENDU
  LOUE       @map("loue")
  RETIRE     @map("retire")
}

enum PublicationStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}

enum Visibility {
  PUBLIC
  OFF_MARKET
  PRIVE
}

enum FurnishedState {
  MEUBLE
  SEMI_MEUBLE @map("semi-meuble")
  NON_MEUBLE  @map("non-meuble")
}

enum PropertyCondition {
  NEUF
  EXCELLENT
  BON_ETAT     @map("bon-etat")
  A_RAFRAICHIR @map("a-rafraichir")
  A_RENOVER    @map("a-renover")
  A_DEMOLIR    @map("a-demolir")
}

enum Orientation {
  NORD
  SUD
  EST
  OUEST
  NORD_EST   @map("nord-est")
  NORD_OUEST @map("nord-ouest")
  SUD_EST    @map("sud-est")
  SUD_OUEST  @map("sud-ouest")
}

/**
 * Mirrors lib/property-schema.ts's Availability — added in phase 6J2 for the extended CSV import.
 */
enum PropertyAvailability {
  IMMEDIATE
  SOUS_1_MOIS    @map("sous-1-mois")
  SOUS_3_MOIS    @map("sous-3-mois")
  SOUS_6_MOIS    @map("sous-6-mois")
  A_LA_LIVRAISON @map("a-la-livraison")
}

enum TagCategory {
  EXTERIEUR     @map("exterieur")
  CONFORT       @map("confort")
  SECURITE      @map("securite")
  LOISIRS       @map("loisirs")
  TECHNIQUE     @map("technique")
  JURIDIQUE     @map("juridique")
  MARKETING
  VUE           @map("vue")
  ENVIRONNEMENT @map("environnement")
  PROXIMITE     @map("proximite")
}

model Property {
  id        String @id @default(cuid())
  reference String @unique
  slug      String @unique

  titleFr          String
  shortDescription String?
  descriptionFr    String?

  transaction     PropertyTransaction
  propertyType    PropertyType
  propertySubtype String?

  status            PropertyStatus    @default(DISPONIBLE)
  publicationStatus PublicationStatus @default(BROUILLON)
  visibility        Visibility        @default(PUBLIC)

  city           String
  district       String?
  addressPublic  String?
  latitude       Float?
  longitude      Float?
  proximityNotes String?

  currency              String   @default("MAD")
  price                 Decimal? @db.Decimal(14, 2)
  priceOnRequest        Boolean  @default(false)
  pricePerSqm           Decimal? @db.Decimal(14, 2)
  negotiable            Boolean  @default(false)
  agencyFeePercent      Decimal? @db.Decimal(5, 2)
  monthlyCharges        Decimal? @db.Decimal(14, 2)
  securityDeposit       Decimal? @db.Decimal(14, 2)
  estimatedYieldPercent Decimal? @db.Decimal(5, 2)

  livingArea   Float?
  builtArea    Float?
  landArea     Float?
  terraceArea  Float?
  balconyArea  Float?
  basementArea Float?

  bedrooms      Int?
  suites        Int?
  bathrooms     Int?
  salons        Int?
  kitchens      Int?
  parkingSpaces Int?
  floor         Int?
  totalFloors   Int?

  yearBuilt    Int?
  furnished    FurnishedState?
  condition    PropertyCondition?
  orientation  Orientation?
  /**
   * Mirrors lib/property-schema.ts's Availability — added in phase 6J2 for the extended CSV import; not yet surfaced in the manual dossier form.
   */
  availability PropertyAvailability?

  isFeatured          Boolean @default(false)
  isGoodDeal          Boolean @default(false)
  isCoupDeCoeur       Boolean @default(false)
  /**
   * Mirrors lib/property-schema.ts's PropertyVisibility.isExclusive — added in phase 6J2, same reasoning as `availability` above.
   */
  isExclusive         Boolean @default(false)
  isCreditEligible    Boolean @default(false)
  isMourabahaEligible Boolean @default(false)

  /**
   * Champs conditionnels très spécifiques par type (villa, riad, terrain,
   * hôtel, commerce, bureau, dépôt, programme neuf). Ne doit jamais contenir
   * les champs publics essentiels déjà modélisés ci-dessus. Validé par
   * lib/admin/property-details-schema.ts (union discriminée par `kind`,
   * calquée sur PropertyTypeGroup de lib/property-schema.ts).
   */
  details Json?

  publishedAt DateTime?
  archivedAt  DateTime?

  /**
   * Provenance CSV (phase 6J1) — `importSource` + `sourceExternalId` forment
   * la clé stable de détection de doublon entre deux imports successifs du
   * même bien externe (ex. l'ancien site capitalparc.ma). Toujours `null`
   * ensemble pour un bien créé à la main dans l'admin. Ne jamais dériver
   * `reference`/`slug` de ces champs : ils restent générés normalement.
   */
  importSource     String?
  sourceExternalId String?

  importRows PropertyImportRow[]

  createdById String
  createdBy   User   @relation("PropertyCreatedBy", fields: [createdById], references: [id])

  /**
   * Dernier utilisateur ayant enregistré une modification (dossier, tags ou
   * données privées) — affiché dans l'écran d'édition à côté de updatedAt.
   */
  updatedById String?
  updatedBy   User?   @relation("PropertyUpdatedBy", fields: [updatedById], references: [id])

  /**
   * Bien attribué à un EDITOR (ou, depuis la 6B2, un AGENT) — seul champ qui
   * lui donne le droit de le modifier en dehors de ce qu'il a lui-même créé
   * (aucun accès aux données privées ni à la publication).
   */
  assignedToId String?
  assignedTo   User?   @relation("PropertyAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags          PropertyTag[]
  private       PropertyPrivate?
  media         PropertyMedia[]
  documents     PropertyDocument[]
  externalLinks PropertyExternalLink[]

  /**
   * Optional rattachement à un programme neuf / lot (phase 6E) — jamais
   * requis, jamais lu par le site public. Un lot peut en principe être
   * rattaché à un seul bien à la fois mais ce n'est pas imposé au niveau
   * schéma (voir lib/real-estate-network/property-links-actions.ts).
   */
  developmentProgramId String?
  developmentProgram   DevelopmentProgram? @relation(fields: [developmentProgramId], references: [id])
  developmentLotId     String?
  developmentLot       DevelopmentLot?     @relation(fields: [developmentLotId], references: [id])

  owners         PropertyOwner[]
  intermediaries PropertyIntermediary[]

  mandates        Mandate[]
  commissionCases CommissionCase[]

  prospectInterests ProspectPropertyInterest[]
  visits            Visit[]
  activities        Activity[]
  opportunities     Opportunity[]

  @@unique([importSource, sourceExternalId])
  @@index([city])
  @@index([transaction])
  @@index([propertyType])
  @@index([publicationStatus])
  @@index([visibility])
  @@index([status])
  @@index([developmentProgramId])
  @@index([developmentLotId])
}

/**
 * Compteur atomique pour la référence NHA-YYYY-000001. Une ligne par année ;
 * l'incrément se fait par un seul UPSERT SQL (voir lib/admin/reference.ts),
 * jamais par un `count()` des biens existants (non sûr en concurrence).
 */
model PropertyReferenceCounter {
  year Int @id
  seq  Int @default(0)
}

model PropertyTag {
  id       String      @id @default(cuid())
  slug     String      @unique
  labelFr  String
  category TagCategory
  isActive Boolean     @default(true)

  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Physiquement séparée de Property : jamais lue par le site public, jamais
 * incluse dans une réponse envoyée à un rôle autre que SUPER_ADMIN/ADMIN
 * (voir lib/property-permissions.ts, canViewPrivateData).
 */
model PropertyPrivate {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  privateAddress String?
  ownerName      String?
  ownerPhone     String?
  ownerEmail     String?

  mandateReference String?
  mandateStartDate DateTime?
  mandateEndDate   DateTime?

  minimumNetPrice Decimal? @db.Decimal(14, 2)
  internalNotes   String?
  source          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Property media (phase 6C)
//
// Local-disk storage only for now: masters and generated variants live under
// storage/properties/{propertyId}/{mediaId}/ (outside public/, git-ignored),
// never served directly — see lib/media/storage.ts and the admin-only
// streaming route at app/api/admin/media/[mediaId]/[variant]/route.ts.
// `storageKey` is the propertyId/mediaId folder key, kept distinct from the
// filesystem path helper so a future move to Cloudflare R2/Images only has
// to change lib/media/storage.ts, not this schema or any caller.
// ---------------------------------------------------------------------------

enum MediaType {
  IMAGE
}

model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       MediaType @default(IMAGE)

  originalFilename String
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?

  /**
   * sha256 of the original file — used to reject obvious duplicates per bien.
   */
  checksum String

  storageKey String

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)
  altText   String?

  uploadedById String
  uploadedBy   User   @relation("PropertyMediaUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, checksum])
  @@index([propertyId, sortOrder])
}

// ---------------------------------------------------------------------------
// Property documents & external links (phase 6D)
//
// Documents: PDF-only master files, local disk, same layout philosophy as
// PropertyMedia — never under public/, never served except through the
// authenticated streaming route at app/api/admin/documents/[documentId]/route.ts.
// Kept in their own storage/properties/{propertyId}/documents/{documentId}/
// subtree so a documentId can never collide with a mediaId's folder.
// DOCUMENT_JURIDIQUE and MANDAT are restricted to ADMIN/SUPER_ADMIN at the
// query/action layer (see canViewPrivateData in lib/property-permissions.ts) —
// there is no schema-level enforcement of that, it must be re-checked by
// every caller.
//
// External links: URL-only rows, domain-allowlisted per type at the action
// layer (lib/admin/property-external-link-schema.ts) — nothing is ever
// fetched from YouTube/Vimeo/Instagram/TikTok, the row just stores the URL.
//
// `visibility` on both models is a future "publish to the public site" flag
// with no public-site wiring yet — every write defaults it to INTERNE, and
// the action layer refuses PUBLIABLE outright while the bien's own
// visibility is OFF_MARKET or PRIVE.
// ---------------------------------------------------------------------------

enum DocumentType {
  BROCHURE
  PLAN
  DOCUMENT_JURIDIQUE
  MANDAT
  AUTRE
}

enum AssetVisibility {
  INTERNE
  PUBLIABLE
}

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type  DocumentType
  title String

  originalFilename String
  mimeType         String
  sizeBytes        Int
  storageKey       String

  visibility AssetVisibility @default(INTERNE)
  sortOrder  Int             @default(0)

  uploadedById String
  uploadedBy   User   @relation("PropertyDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mandate Mandate?

  @@index([propertyId, sortOrder])
}

enum ExternalLinkType {
  VIDEO_YOUTUBE
  VIDEO_VIMEO
  VISITE_VIRTUELLE
  INSTAGRAM
  TIKTOK
  AUTRE
}

model PropertyExternalLink {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type  ExternalLinkType
  url   String
  title String?

  visibility AssetVisibility @default(INTERNE)
  sortOrder  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, sortOrder])
}

// ---------------------------------------------------------------------------
// Real-estate network (phase 6E)
//
// Owners, promoters/programs/lots and intermediaries are strictly internal —
// never read by the public site, never exposed to AGENT/EDITOR/VIEWER (see
// lib/real-estate-network/permissions.ts, canManageRealEstateNetwork). Every
// query/action layer must re-check that helper itself; there is no
// schema-level enforcement.
//
// PropertyPrivate.ownerName/ownerPhone/ownerEmail (phase 6B2) are untouched —
// they keep surfacing as unstructured historical data until a real Owner is
// linked through PropertyOwner. No automatic migration between the two.
// ---------------------------------------------------------------------------

enum PartyKind {
  PHYSIQUE
  SOCIETE
}

enum ContactPreference {
  TELEPHONE
  EMAIL
  WHATSAPP
  COURRIER
}

enum ProgramStatus {
  ETUDE
  COMMERCIALISATION
  LIVRE
  SUSPENDU
}

enum LotStatus {
  DISPONIBLE
  OPTIONNE
  RESERVE
  VENDU
}

enum IntermediaryType {
  APPORTEUR
  AGENCE_PARTENAIRE
  COURTIER
  NOTAIRE
  AUTRE
}

enum PropertyOwnerRole {
  PROPRIETAIRE
  INDIVISAIRE
  USUFRUITIER
  MANDATAIRE
  AUTRE
}

enum CommissionType {
  POURCENTAGE
  FORFAIT
}

model Owner {
  id                String             @id @default(cuid())
  kind              PartyKind          @default(PHYSIQUE)
  fullNameOrCompany String
  cinOrIce          String?
  phone             String?
  email             String?
  address           String?
  city              String?
  contactPreference ContactPreference?
  internalNotes     String?
  isActive          Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyLinks PropertyOwner[]
  mandates      Mandate[]

  @@index([isActive])
  @@index([city])
}

model Promoter {
  id              String  @id @default(cuid())
  companyName     String
  mainContactName String?
  phone           String?
  email           String?
  website         String?
  ice             String?
  address         String?
  city            String?
  internalNotes   String?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs DevelopmentProgram[]

  @@index([isActive])
  @@index([city])
}

model DevelopmentProgram {
  id         String   @id @default(cuid())
  promoterId String
  promoter   Promoter @relation(fields: [promoterId], references: [id])

  name                 String
  city                 String
  district             String?
  address              String?
  latitude             Float?
  longitude            Float?
  internalDescription  String?
  status               ProgramStatus @default(ETUDE)
  expectedDeliveryDate DateTime?
  indicativeLotCount   Int?
  isActive             Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots       DevelopmentLot[]
  properties Property[]

  @@index([promoterId])
  @@index([isActive])
  @@index([status])
}

model DevelopmentLot {
  id        String             @id @default(cuid())
  programId String
  program   DevelopmentProgram @relation(fields: [programId], references: [id])

  reference String
  lotType   String?
  typology  String?
  surface   Float?
  price     Decimal?  @db.Decimal(14, 2)
  status    LotStatus @default(DISPONIBLE)
  floor     String?
  block     String?
  extraInfo Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@unique([programId, reference])
  @@index([status])
}

model Intermediary {
  id            String           @id @default(cuid())
  kind          PartyKind        @default(PHYSIQUE)
  nameOrCompany String
  phone         String?
  email         String?
  type          IntermediaryType @default(AUTRE)
  city          String?
  internalNotes String?
  isActive      Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyLinks    PropertyIntermediary[]
  commissionShares CommissionShare[]

  @@index([isActive])
  @@index([type])
}

/**
 * Many-to-many Property <-> Owner, with per-link ownership metadata.
 */
model PropertyOwner {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      Owner    @relation(fields: [ownerId], references: [id])

  role          PropertyOwnerRole @default(PROPRIETAIRE)
  quoteShare    Decimal?          @db.Decimal(5, 2)
  isMainContact Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, ownerId])
  @@index([ownerId])
}

/**
 * Many-to-many Property <-> Intermediary. Commission fields are placeholders
 * for the future financial module (kept optional, never computed here).
 */
model PropertyIntermediary {
  id             String       @id @default(cuid())
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  intermediaryId String
  intermediary   Intermediary @relation(fields: [intermediaryId], references: [id])

  role IntermediaryType?
  note String?

  commissionType   CommissionType?
  commissionRate   Decimal?        @db.Decimal(5, 2)
  commissionAmount Decimal?        @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, intermediaryId])
  @@index([intermediaryId])
}

// ---------------------------------------------------------------------------
// Mandates, commissions & internal financial follow-up (phase 6F)
//
// Strictly internal: never read by the public site, never exposed to
// AGENT/EDITOR/VIEWER — even via direct URL or Server Action (see
// lib/finance/permissions.ts, canManageFinance). Every query/action layer
// must re-check that helper itself; there is no schema-level enforcement.
//
// No online payment integration and no official accounting: CommissionPayment
// only tracks manually-entered settlement status. No automatic legal tax is
// computed anywhere in this module — every rate and amount is admin-entered
// or admin-validated.
//
// Nothing here is ever physically deleted once it has payments attached —
// a Mandate is retired via MandateStatus.RESILIE and a CommissionCase via
// CommissionCaseStatus.ANNULEE, never prisma.delete().
// ---------------------------------------------------------------------------

enum MandateType {
  VENTE
  LOCATION
  EXCLUSIF
  SIMPLE
  OFF_MARKET
}

enum MandateStatus {
  BROUILLON
  ACTIF
  EXPIRE
  RESILIE
  FINALISE
}

/**
 * Atomic counter for the MAN-YYYY-000001 mandate reference, same pattern as
 * PropertyReferenceCounter (see lib/finance/reference.ts) — never derived
 * from a count() of existing rows.
 */
model MandateReferenceCounter {
  year Int @id
  seq  Int @default(0)
}

model Mandate {
  id        String @id @default(cuid())
  reference String @unique

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId    String?
  owner      Owner?   @relation(fields: [ownerId], references: [id])

  type   MandateType
  status MandateStatus @default(BROUILLON)

  startDate DateTime?
  endDate   DateTime?

  isExclusive Boolean @default(false)

  displayedPrice       Decimal? @db.Decimal(14, 2)
  agreedNetSellerPrice Decimal? @db.Decimal(14, 2)

  internalConditions String?

  /**
   * Optional link to the scanned mandate PDF, already uploaded through the
   * phase 6D document manager (type MANDAT). One document can back at most
   * one mandate (@unique) — it is never uploaded from this module directly.
   */
  documentId String?           @unique
  document   PropertyDocument? @relation(fields: [documentId], references: [id])

  createdById String
  createdBy   User   @relation("MandateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissionCases CommissionCase[]

  @@index([propertyId])
  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([endDate])
}

enum CommissionTransactionType {
  VENTE
  LOCATION
}

enum CommissionCaseStatus {
  PREVISION
  A_CONFIRMER
  DUE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

enum CommissionBasis {
  PRIX_FINAL
  LOYER_ANNUEL
  MONTANT_FIXE
}

enum CommissionBilledTo {
  VENDEUR
  ACQUEREUR
  LOCATAIRE
}

/**
 * Atomic counter for the COM-YYYY-000001 commission-case reference, same
 * pattern as PropertyReferenceCounter / MandateReferenceCounter.
 */
model CommissionReferenceCounter {
  year Int @id
  seq  Int @default(0)
}

model CommissionCase {
  id        String @id @default(cuid())
  reference String @unique

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mandateId  String?
  mandate    Mandate? @relation(fields: [mandateId], references: [id])

  /**
   * Optional link to the commercial Opportunity this dossier settles (phase
   * 6L). Always set explicitly by an admin — winning an Opportunity never
   * creates or links a CommissionCase on its own.
   */
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  transaction CommissionTransactionType
  status      CommissionCaseStatus      @default(PREVISION)

  basis      CommissionBasis
  baseAmount Decimal         @db.Decimal(14, 2)

  /**
   * Rate is optional (a case can be a flat MONTANT_FIXE with no rate at
   * all); the resulting agency amount is always populated, whether it was
   * computed from the rate or entered directly — see
   * lib/finance/commission-actions.ts.
   */
  agencyCommissionRate   Decimal? @db.Decimal(5, 2)
  agencyCommissionAmount Decimal  @db.Decimal(14, 2)

  billedTo CommissionBilledTo?

  currency String @default("MAD")

  finalTransactionAmount Decimal? @db.Decimal(14, 2)

  expectedCollectionDate DateTime?
  internalNotes          String?

  createdById String
  createdBy   User   @relation("CommissionCaseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares   CommissionShare[]
  payments CommissionPayment[]

  @@index([propertyId])
  @@index([mandateId])
  @@index([opportunityId])
  @@index([status])
  @@index([transaction])
}

enum CommissionBeneficiaryType {
  AGENCE
  INTERMEDIAIRE
  AGENT_INTERNE
  AUTRE
}

enum CommissionShareMode {
  POURCENTAGE
  MONTANT_FIXE
}

enum CommissionShareStatus {
  PREVU
  VALIDE
  PAYE
}

/**
 * A share can never be deleted once it has a CommissionPayment pointing at
 * it — enforced at the action layer, not by onDelete restrictions, so the
 * error message can stay in French and specific.
 */
model CommissionShare {
  id String @id @default(cuid())

  commissionCaseId String
  commissionCase   CommissionCase @relation(fields: [commissionCaseId], references: [id], onDelete: Cascade)

  beneficiaryType CommissionBeneficiaryType

  intermediaryId String?
  intermediary   Intermediary? @relation(fields: [intermediaryId], references: [id])
  userId         String?
  user           User?         @relation("CommissionShareAgent", fields: [userId], references: [id])

  /**
   * Only ever set (and only ever meaningful) when beneficiaryType is AUTRE.
   */
  freeBeneficiaryName String?

  mode  CommissionShareMode
  value Decimal             @db.Decimal(14, 2)

  /**
   * Always populated: `value` directly when mode is MONTANT_FIXE, or
   * value% of the parent CommissionCase.agencyCommissionAmount when mode is
   * POURCENTAGE — recomputed server-side on every write, never trusted from
   * the client.
   */
  computedAmount Decimal @db.Decimal(14, 2)

  status CommissionShareStatus @default(PREVU)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments CommissionPayment[]

  @@index([commissionCaseId])
  @@index([intermediaryId])
  @@index([userId])
}

enum CommissionPaymentStatus {
  PREVU
  RECU
  PARTIEL
  ANNULE
}

model CommissionPayment {
  id String @id @default(cuid())

  commissionCaseId  String
  commissionCase    CommissionCase   @relation(fields: [commissionCaseId], references: [id], onDelete: Cascade)
  commissionShareId String?
  commissionShare   CommissionShare? @relation(fields: [commissionShareId], references: [id])

  amount Decimal @db.Decimal(14, 2)

  expectedDate DateTime?
  paidDate     DateTime?

  status CommissionPaymentStatus @default(PREVU)

  internalReference String?
  paymentMethod     String?
  internalNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commissionCaseId])
  @@index([commissionShareId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Operational CRM: prospects, visits and follow-ups (phase 6G1)
//
// Manual back-office tracking only — the public /contact, /vendre and
// /off-market forms are NOT wired to these tables yet (a later phase), and
// there is no SMS/e-mail/WhatsApp/calendar automation here, only rows an
// admin/agent enters by hand.
//
// Contact details and every free-text note (Prospect.internalNotes,
// Visit.preVisitNote/prospectFeedback/internalNote, Activity.content) must
// never be written into AuditLog.metadata — only structural fields (ids,
// enum values, field names) are logged, same rule as lib/finance/*.
//
// AGENT only ever creates/reads/edits a Prospect/Visit/Activity it created
// or is assignedTo; EDITOR/VIEWER only ever read what is assignedTo them,
// and only EDITOR may edit a Visit/Activity (never a Prospect) assignedTo
// it. See lib/crm/permissions.ts — every query/action must call it itself,
// there is no schema-level enforcement.
//
// Nothing here is ever physically deleted once it exists: a Prospect is
// retired via ProspectStatus.ARCHIVE, a Visit via VisitStatus.ANNULEE, an
// Activity via ActivityStatus.ANNULEE — never prisma.delete().
// ---------------------------------------------------------------------------

enum ProspectType {
  ACHETEUR
  LOCATAIRE
  VENDEUR
  INVESTISSEUR
  AUTRE
}

enum ProspectLanguage {
  FR
  AR
  EN
}

enum ProspectSource {
  SITE_WEB
  WHATSAPP
  TELEPHONE
  RECOMMANDATION
  RESEAUX_SOCIAUX
  PORTAIL
  AUTRE
}

enum ProspectStatus {
  NOUVEAU
  A_QUALIFIER
  QUALIFIE
  VISITE_PLANIFIEE
  OFFRE
  NEGOCIATION
  GAGNE
  PERDU
  ARCHIVE
}

/**
 * Which public form (phase 6G2) produced this Prospect — null for every
 * prospect entered by hand in the back office. Purely informational (badge +
 * filter in /admin/demandes), never read by lib/crm/permissions.ts.
 */
enum ProspectFormOrigin {
  CONTACT
  VENDRE
  OFF_MARKET
}

enum InterestLevel {
  A_SUIVRE
  INTERESSE
  FAVORI
  REFUSE
}

enum VisitStatus {
  PLANIFIEE
  CONFIRMEE
  REALISEE
  ANNULEE
  ABSENT
}

enum VisitType {
  PREMIERE_VISITE
  REVISITE
  VISITE_PROPRIETAIRE
  AUTRE
}

enum PostVisitInterest {
  AUCUN
  FAIBLE
  MOYEN
  FORT
  OFFRE_ENVISAGEE
}

enum ActivityType {
  APPEL
  WHATSAPP
  EMAIL
  NOTE
  TACHE
  RELANCE
}

enum ActivityStatus {
  A_FAIRE
  TERMINEE
  ANNULEE
}

/**
 * Atomic counter for the PRO-YYYY-000001 prospect reference, same pattern as PropertyReferenceCounter.
 */
model ProspectReferenceCounter {
  year Int @id
  seq  Int @default(0)
}

/**
 * Atomic counter for the VIS-YYYY-000001 visit reference, same pattern as PropertyReferenceCounter.
 */
model VisitReferenceCounter {
  year Int @id
  seq  Int @default(0)
}

model Prospect {
  id        String @id @default(cuid())
  reference String @unique

  type ProspectType
  kind PartyKind    @default(PHYSIQUE)

  firstName   String?
  lastName    String?
  companyName String?

  phone String
  email String?

  preferredLanguage ProspectLanguage @default(FR)
  source            ProspectSource   @default(AUTRE)
  status            ProspectStatus   @default(NOUVEAU)

  searchCities        String[]
  searchDistricts     String[]
  searchPropertyTypes PropertyType[]
  searchTransaction   PropertyTransaction?

  budgetMin Decimal? @db.Decimal(14, 2)
  budgetMax Decimal? @db.Decimal(14, 2)
  currency  String   @default("MAD")

  /**
   * Free-text project timeline ("3 mois", "T1 2027"…) — deliberately not a strict date.
   */
  projectTimeline String?

  internalNotes String?

  /**
   * Which public form created this row (phase 6G2) — null for a prospect
   * entered by hand in the back office. See lib/crm/public-request-actions.ts.
   */
  formOrigin ProspectFormOrigin?

  /**
   * Optional: a public /contact, /vendre or /off-market submission has no
   * authenticated back-office user behind it. See
   * lib/crm/public-request-actions.ts, which never sets this field.
   */
  createdById String?
  createdBy   User?   @relation("ProspectCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("ProspectAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyInterests ProspectPropertyInterest[]
  visits            Visit[]
  activities        Activity[]
  notifications     Notification[]
  opportunities     Opportunity[]

  @@index([status])
  @@index([type])
  @@index([source])
  @@index([assignedToId])
  @@index([createdById])
  @@index([formOrigin])
  @@index([phone])
  @@index([email])
}

/**
 * Many-to-many Prospect <-> Property, with per-link interest metadata.
 */
model ProspectPropertyInterest {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  interestLevel InterestLevel @default(A_SUIVRE)
  internalNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([prospectId, propertyId])
  @@index([propertyId])
}

model Visit {
  id        String @id @default(cuid())
  reference String @unique

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("VisitAssignedTo", fields: [assignedToId], references: [id])

  scheduledStart DateTime
  scheduledEnd   DateTime?

  status VisitStatus @default(PLANIFIEE)
  type   VisitType   @default(PREMIERE_VISITE)

  participantsCount Int?

  preVisitNote     String?
  prospectFeedback String?
  internalNote     String?

  postVisitInterest PostVisitInterest?
  nextFollowUpAt    DateTime?

  /**
   * Optional Opportunity this visit belongs to (phase 6L) — always the same prospect, checked at the action layer.
   */
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("VisitCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities    Activity[]
  notifications Notification[]

  @@index([propertyId])
  @@index([prospectId])
  @@index([assignedToId])
  @@index([opportunityId])
  @@index([status])
  @@index([scheduledStart])
}

model Activity {
  id String @id @default(cuid())

  prospectId    String
  prospect      Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  propertyId    String?
  property      Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  visitId       String?
  visit         Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  /**
   * Optional Opportunity this action belongs to (phase 6L) — always the same prospect, checked at the action layer.
   */
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  type ActivityType

  title   String
  content String?

  dueAt       DateTime?
  completedAt DateTime?

  status ActivityStatus @default(A_FAIRE)

  assignedToId String?
  assignedTo   User?   @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("ActivityCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([prospectId])
  @@index([propertyId])
  @@index([visitId])
  @@index([opportunityId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Internal notifications (phase 6H1)
//
// Purely operational, server-created rows telling a back-office user what
// needs their attention today — never an external channel (no e-mail/SMS/
// WhatsApp/push here, see AGENTS.md / the 6H1 brief). `message` must never
// carry phone/e-mail/budget/internalNotes content, same rule as AuditLog —
// see lib/crm/notification-service.ts.
// ---------------------------------------------------------------------------

enum NotificationType {
  NOUVELLE_DEMANDE
  RELANCE_AUJOURD_HUI
  RELANCE_EN_RETARD
  VISITE_A_VENIR
  VISITE_MODIFIEE
  VISITE_ANNULEE
  PROSPECT_ASSIGNE
  OPPORTUNITE_ASSIGNEE
  OPPORTUNITE_STADE
  OPPORTUNITE_CLOTURE_PROCHE
  OPPORTUNITE_SANS_ACTIVITE
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  prospectId    String?
  prospect      Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  visitId       String?
  visit         Visit?       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  activityId    String?
  activity      Activity?    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([opportunityId])
}

// ---------------------------------------------------------------------------
// Commercial opportunities & pipeline (phase 6L)
//
// One Opportunity = one potential deal for one Prospect (and, from the VISITE
// stage onward, one Property). Same ownership model as the rest of the CRM
// (createdById/assignedToId, see lib/crm/opportunity-permissions.ts), same
// "nothing is ever physically deleted" rule: a dead deal is moved to PERDUE.
//
// Financial rule: `estimatedAmount`/`finalAmount` are DEAL amounts (sale price
// or rent), never agency revenue. "Volume pipeline" and "Prévisionnel
// pondéré" are derived from them only. Commissions prévues/encaissées always
// come from CommissionCase/CommissionPayment (optionally linked through
// CommissionCase.opportunityId) — never computed from an Opportunity. Winning
// an Opportunity never creates a CommissionCase automatically.
//
// AuditLog.metadata for this module carries ids, stages and field NAMES only —
// never amounts, probability, internal notes or loss details.
// ---------------------------------------------------------------------------

enum OpportunityStage {
  NOUVELLE
  QUALIFICATION
  MATCHING
  VISITE
  OFFRE
  NEGOCIATION
  RESERVATION
  COMPROMIS
  FINANCEMENT
  ACTE
  GAGNEE
  PERDUE
}

enum OpportunityLossReason {
  PRIX
  FINANCEMENT
  BIEN_INDISPONIBLE
  CONCURRENT
  SANS_REPONSE
  AUTRE
}

/**
 * Atomic counter for the OPP-YYYY-000001 opportunity reference, same pattern as PropertyReferenceCounter.
 */
model OpportunityReferenceCounter {
  year Int @id
  seq  Int @default(0)
}

model Opportunity {
  id        String @id @default(cuid())
  reference String @unique

  prospectId String
  prospect   Prospect  @relation(fields: [prospectId], references: [id])
  /**
   * Optional while NOUVELLE/QUALIFICATION/MATCHING (or PERDUE); required from VISITE onward — enforced in lib/crm/opportunity-rules.ts.
   */
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  transaction PropertyTransaction
  title       String

  stage OpportunityStage @default(NOUVELLE)

  /**
   * Deal amount (price / rent) — never agency revenue.
   */
  estimatedAmount Decimal? @db.Decimal(14, 2)
  /**
   * Deal amount actually agreed — required to move to GAGNEE.
   */
  finalAmount     Decimal? @db.Decimal(14, 2)
  currency        String   @default("MAD")

  /**
   * 0–100. Reset to the stage default on every stage change; only SUPER_ADMIN/ADMIN may override it afterwards (probabilityIsManual).
   */
  probability         Int     @default(5)
  probabilityIsManual Boolean @default(false)

  expectedCloseDate DateTime?
  /**
   * Set when the opportunity reaches GAGNEE (actual closing date, entered by the user) or PERDUE; cleared on reopen.
   */
  closedAt          DateTime?

  lossReason OpportunityLossReason?
  lossNote   String?

  internalNote String?

  assignedToId String?
  assignedTo   User?   @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("OpportunityCreatedBy", fields: [createdById], references: [id])

  /**
   * Bumped on creation, stage change, edit and every linked activity/visit write — feeds the "sans activité depuis 7 jours" signal.
   */
  lastActivityAt DateTime @default(now())
  stageChangedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities      Activity[]
  visits          Visit[]
  commissionCases CommissionCase[]
  stageHistory    OpportunityStageHistory[]
  notifications   Notification[]

  @@index([prospectId])
  @@index([propertyId])
  @@index([stage])
  @@index([assignedToId])
  @@index([createdById])
  @@index([expectedCloseDate])
  @@index([lastActivityAt])
}

/**
 * Append-only stage journal (phase 6L) — one row per stage transition, including the initial stage.
 */
model OpportunityStageHistory {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  fromStage OpportunityStage?
  toStage   OpportunityStage

  changedById String
  changedBy   User   @relation("OpportunityStageChangedBy", fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  @@index([opportunityId, createdAt])
}

// ---------------------------------------------------------------------------
// CSV property import (phase 6J1)
//
// SUPER_ADMIN/ADMIN only, enforced in lib/admin/import-permissions.ts and
// re-checked by every action — no schema-level enforcement. Two-step flow:
// A) uploadAndValidateImportBatch parses the CSV and writes one
//    PropertyImportRow per line with status VALIDE/ERREUR, never touching
//    Property; B) runImportBatch creates/updates only the VALIDE rows, always
//    as publicationStatus BROUILLON regardless of what the CSV says, and
//    never writes media, documents, PropertyPrivate, mandates or CRM data.
//
// PropertyImportRow.sourceData/errors intentionally carry the raw CSV
// content for that single row (public catalogue fields only — this V1 CSV
// has no owner/private columns) so the admin can review it; AuditLog entries
// for this module must stay limited to batchId + counters, never full row
// content (see lib/admin/import-actions.ts).
// ---------------------------------------------------------------------------

enum ImportSourceType {
  CAPITAL_PARC
  AUTRE
}

enum ImportBatchStatus {
  BROUILLON
  VALIDE
  IMPORTE
  ECHEC
}

enum ImportRowStatus {
  VALIDE
  ERREUR
  IGNORE
  IMPORTE
}

model PropertyImportBatch {
  id        String            @id @default(cuid())
  reference String            @unique
  fileName  String
  source    ImportSourceType
  status    ImportBatchStatus @default(BROUILLON)

  rowCount     Int @default(0)
  validCount   Int @default(0)
  errorCount   Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)

  /**
   * Quality-report counters added in phase 6J2 (extended CSV: coordinates,
   * images). coordinatesValidCount counts rows with a valid latitude+longitude
   * pair among the imported rows; the image counters are filled once step B
   * (runImportBatch) actually downloads image_urls — see lib/admin/import-actions.ts.
   */
  coordinatesValidCount Int @default(0)
  imagesDownloadedCount Int @default(0)
  imagesRejectedCount   Int @default(0)

  /**
   * Column headers present in the uploaded file but outside the known CSV contract — tolerated, never read, just reported (phase 6J2).
   */
  ignoredColumns Json?

  createdById String
  createdBy   User   @relation("PropertyImportBatchCreatedBy", fields: [createdById], references: [id])

  importedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows PropertyImportRow[]

  @@index([status])
  @@index([createdById])
}

model PropertyImportRow {
  id      String              @id @default(cuid())
  batchId String
  batch   PropertyImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  lineNumber Int

  /**
   * Raw CSV columns for this line, as submitted — public catalogue fields only in this V1 template.
   */
  sourceData Json

  status ImportRowStatus @default(ERREUR)

  /**
   * Non-sensitive, human-readable validation/import messages — never owner/private data (this template has none anyway).
   */
  errors Json?

  /**
   * Per-image_urls outcome messages (rejections), filled during step B — phase 6J2. Never blocks the row/bien (see lib/admin/import-image-fetch.ts).
   */
  imageErrors         Json?
  imagesImportedCount Int   @default(0)

  isUpdate Boolean @default(false)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, lineNumber])
  @@index([batchId, status])
}
