# Copy this file to `.env` for local development. `.env` is git-ignored — never commit real values.
#
#   cp .env.example .env
#
# This file documents every variable the app needs; it contains no production secret.

# --- PostgreSQL (local Docker Compose service, see docker-compose.dev.yml) ---
# Exposed only on 127.0.0.1:5433 to avoid clashing with other local projects.
POSTGRES_USER=na_business_africa
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=na_business_africa

# --- Prisma connection string ---
# Must match the POSTGRES_* values above and the port exposed by docker-compose.dev.yml.
DATABASE_URL="postgresql://na_business_africa:change_me_locally@127.0.0.1:5433/na_business_africa?schema=public"

# --- Session signing key ---
# Generate a local value with: openssl rand -base64 32
SESSION_SECRET=

# --- Dev-only seed admin account ---
# Used exclusively by `pnpm db:seed` to create/update one SUPER_ADMIN account for local development.
# Never put a real personal email or password here or in code.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_locally_min_12_chars

# --- Mapbox (admin property map picker) ---
# Public token used client-side to render the interactive map in the "Localisation & carte" tab.
# Create one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Public site URL ---
# Absolute origin the public site is served from, used for the sitemap, robots.txt
# and canonical/Open Graph URLs. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
